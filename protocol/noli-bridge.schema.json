{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MelonSmasher/omp-noli/protocol/noli-bridge.schema.json",
  "title": "Noli bridge protocol, version 1",
  "description": "Every frame the bridge sends. Enumerations are closed: a client may treat an unlisted value as a protocol violation. Keep in sync with src/protocol.ts; tests check that the enumerations match and that every emitted frame validates.",
  "$ref": "#/$defs/ServerFrame",
  "$defs": {
    "ServerFrame": { "oneOf": [{ "$ref": "#/$defs/ResponseFrame" }, { "$ref": "#/$defs/EventFrame" }] },

    "RequestId": { "type": ["string", "number", "null"] },

    "ResponseFrame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "ok", "result"],
          "properties": { "type": { "const": "response" }, "id": { "$ref": "#/$defs/RequestId" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/Result" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "ok", "error"],
          "properties": { "type": { "const": "response" }, "id": { "$ref": "#/$defs/RequestId" }, "ok": { "const": false }, "error": { "$ref": "#/$defs/ErrorBody" } }
        }
      ]
    },

    "Result": {
      "description": "Result of one method. Which variant applies follows from the request's method.",
      "anyOf": [
        { "$ref": "#/$defs/HelloResult" },
        { "$ref": "#/$defs/CapabilitiesResult" },
        { "$ref": "#/$defs/DefinitionsResult" },
        { "$ref": "#/$defs/ListResult" },
        { "$ref": "#/$defs/QueuedResult" },
        { "$ref": "#/$defs/TurnResult" },
        { "$ref": "#/$defs/KillResult" }
      ]
    },

    "HelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sessionId", "pid", "capabilities"],
      "properties": {
        "protocol": { "const": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "pid": { "type": "integer" },
        "capabilities": { "$ref": "#/$defs/Capabilities" }
      }
    },
    "CapabilitiesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": { "capabilities": { "$ref": "#/$defs/Capabilities" } }
    },
    "DefinitionsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions"],
      "properties": { "definitions": { "type": "array", "items": { "$ref": "#/$defs/DefinitionView" } } }
    },
    "ListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "discovery"],
      "properties": { "agents": { "type": "array", "items": { "$ref": "#/$defs/AgentView" } }, "discovery": { "$ref": "#/$defs/DiscoveryReport" } }
    },
    "QueuedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queued"],
      "properties": { "queued": { "const": true } }
    },
    "TurnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "exitCode", "aborted"],
      "properties": { "output": { "type": "string" }, "exitCode": { "type": ["integer", "null"] }, "aborted": { "type": "boolean" } }
    },
    "KillResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["killed", "mode"],
      "properties": { "killed": { "type": "boolean" }, "mode": { "enum": ["live", "parked"] } }
    },

    "CapabilityName": {
      "enum": ["agents.list", "agents.list.persisted", "agents.steer", "agents.followUp", "agents.turn", "agents.kill.live", "agents.kill.parked", "definitions.list"]
    },
    "CapabilityReason": { "enum": ["export_missing", "tool_missing", "hook_changed", "runtime_failure", "not_ready"] },
    "CapabilityApi": { "enum": ["public", "internal"] },
    "CapabilityState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "api", "detail"],
          "properties": { "available": { "const": true }, "api": { "$ref": "#/$defs/CapabilityApi" }, "detail": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "api", "reason", "detail"],
          "properties": {
            "available": { "const": false },
            "api": { "$ref": "#/$defs/CapabilityApi" },
            "reason": { "$ref": "#/$defs/CapabilityReason" },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents.list", "agents.list.persisted", "agents.steer", "agents.followUp", "agents.turn", "agents.kill.live", "agents.kill.parked", "definitions.list"],
      "properties": {
        "agents.list": { "$ref": "#/$defs/CapabilityState" },
        "agents.list.persisted": { "$ref": "#/$defs/CapabilityState" },
        "agents.steer": { "$ref": "#/$defs/CapabilityState" },
        "agents.followUp": { "$ref": "#/$defs/CapabilityState" },
        "agents.turn": { "$ref": "#/$defs/CapabilityState" },
        "agents.kill.live": { "$ref": "#/$defs/CapabilityState" },
        "agents.kill.parked": { "$ref": "#/$defs/CapabilityState" },
        "definitions.list": { "$ref": "#/$defs/CapabilityState" }
      }
    },

    "AgentKind": { "enum": ["main", "sub", "advisor", "unknown"] },
    "AgentState": { "enum": ["running", "idle", "parked", "terminated", "unknown"] },
    "AgentView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "parentId", "state", "live", "streaming", "activity", "definition", "createdAt", "lastActivity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/AgentKind" },
        "parentId": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/AgentState" },
        "live": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "activity": { "type": ["string", "null"] },
        "definition": { "type": ["string", "null"] },
        "createdAt": { "type": "number", "description": "Milliseconds since the Unix epoch." },
        "lastActivity": { "type": "number", "description": "Milliseconds since the Unix epoch." }
      }
    },

    "DiscoveryStatus": { "enum": ["complete", "skipped", "inconclusive", "unavailable", "none", "not_requested"] },
    "DiscoveryReason": { "enum": ["host_declined", "previously_declined", "no_scan_evidence", "lookup_failed", "capability_unavailable", "no_root"] },
    "DiscoveryReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "detail", "restored", "pending"],
      "properties": {
        "status": { "$ref": "#/$defs/DiscoveryStatus" },
        "reason": { "oneOf": [{ "$ref": "#/$defs/DiscoveryReason" }, { "type": "null" }] },
        "detail": { "type": "string" },
        "restored": { "type": "array", "items": { "type": "string" } },
        "pending": { "type": "array", "items": { "type": "string" } }
      }
    },

    "DefinitionSource": { "enum": ["bundled", "user", "project", "unknown"] },
    "DefinitionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "source"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "source": { "$ref": "#/$defs/DefinitionSource" } }
    },

    "ErrorCode": {
      "enum": [
        "unauthorized",
        "stale_session",
        "unknown_agent",
        "unknown_definition",
        "definition_required",
        "forbidden_kind",
        "parked",
        "already_terminal",
        "busy",
        "capability_unavailable",
        "bad_request",
        "bad_frame",
        "frame_too_large",
        "unknown_method",
        "not_ready",
        "internal"
      ]
    },
    "ErrorBody": {
      "description": "capability_unavailable carries the capability and its reason; every other code carries only code and message.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "capability", "reason"],
          "properties": {
            "code": { "const": "capability_unavailable" },
            "message": { "type": "string" },
            "capability": { "$ref": "#/$defs/CapabilityName" },
            "reason": { "$ref": "#/$defs/CapabilityReason" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "allOf": [{ "$ref": "#/$defs/ErrorCode" }, { "not": { "const": "capability_unavailable" } }] },
            "message": { "type": "string" }
          }
        }
      ]
    },

    "EventFrame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event", "sessionId", "agent"],
          "properties": {
            "type": { "const": "event" },
            "event": { "const": "agent.changed" },
            "sessionId": { "type": "string", "minLength": 1 },
            "agent": { "$ref": "#/$defs/AgentView" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event", "sessionId", "capabilities"],
          "properties": {
            "type": { "const": "event" },
            "event": { "const": "capabilities.changed" },
            "sessionId": { "type": "string", "minLength": 1 },
            "capabilities": { "$ref": "#/$defs/Capabilities" }
          }
        }
      ]
    }
  }
}
